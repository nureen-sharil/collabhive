# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file to GitHub.

# Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
# - Default XAMPP root (no password): mysql+pymysql://root:@localhost:3306/collab_hive
# - If your MySQL runs on port 3307:  mysql+pymysql://root:@localhost:3307/collab_hive
# - If root has a password:           mysql+pymysql://root:yourpassword@localhost:3306/collab_hive
# - Aiven / hosted MySQL:             mysql+pymysql://avnadmin:PASSWORD@HOST:PORT/defaultdb

DATABASE_URL=mysql+pymysql://avnadmin:YOUR_PASSWORD@mysql-c7d044d-collabhive.l.aivencloud.com:17415/defaultdb

# auto enables SSL for hosted MySQL and disables it for localhost.
# Set to true on Render when using Aiven.
DATABASE_SSL=auto
